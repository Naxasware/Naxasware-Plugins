  APP --> NOT[Notification Sender]
  UI[Review UI] <--> APP
  UI <--> REG
  APP --> GW[ERP Gateway]
  GW --> ERP[ERP System]
  REG --> DB[(Invoice Database)]
  APP --> AUD[Audit Log]
  GW --> AUD
